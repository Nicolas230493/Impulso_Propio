# Copiar a .env y completar. Nunca subir .env al repo.
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# SQLite para desarrollo; en producción: postgres://usuario:clave@host:5432/gastos
DATABASE_URL=sqlite:///db.sqlite3
# Mail para recupero de contraseña. En desarrollo se imprime en consola.
EMAIL_URL=consolemail://
# EMAIL_URL=smtp+tls://usuario:clave@smtp.gmail.com:587
DEFAULT_FROM_EMAIL=Gastos con Propósito <no-responder@tudominio.com>
# Solo para la migración de datos: conexión Postgres directa a Supabase.
SUPABASE_DATABASE_URL=
